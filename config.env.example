PORT=8000
NODE_ENV=development

# --- Production (VPS / bare metal) ---
# NODE_ENV=production
# Local Postgres on the same host: keep sslmode=disable in DATABASE_URL.
# Example:
# DATABASE_URL=postgresql://menu_app:YOUR_PASSWORD@localhost:5432/menu_db?sslmode=disable

# Comma-separated browser origins for CORS (e.g. https://admin.example.com). Leave empty for permissive mode.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Set true to expose /api/docs in production (default: off when NODE_ENV=production)
# ENABLE_SWAGGER=false

# Database Configuration
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=menu_db
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql://postgres:password@localhost:5432/menu_db?sslmode=disable

# Security
JWT_SECRET=your-super-secret-key-change-this

# Local file uploads via POST /api/upload (and related module routes).
# Files are served via GET /api/media/... (not the upload routes).
# UPLOAD_DIR=uploads
# Required for absolute image URLs in API responses (mobile clients).
# PUBLIC_BASE_URL=http://203.0.113.10:8000
# → response imageUrl example: http://203.0.113.10:8000/api/media/uploads/<uuid>.jpg
