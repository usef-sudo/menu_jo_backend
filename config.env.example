PORT=8000
NODE_ENV=development

# Comma-separated browser origins for CORS (e.g. https://admin.example.com). Leave empty for permissive mode.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Set true to expose /api/docs in production (default: off when NODE_ENV=production)
# ENABLE_SWAGGER=false

# Database Configuration
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=menu_db
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql://postgres:password@localhost:5432/menu_db?sslmode=disable

# Security
JWT_SECRET=your-super-secret-key-change-this

# AWS Configuration (S3 for Image Uploads)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-s3-bucket-name
